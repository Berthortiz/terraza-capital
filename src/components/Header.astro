---
import { Icon } from "astro-icon/components";
import GlassButton from "./GlassButton.astro";
import Logo from "../assets/logo.png";

const links = [
    { href: "#", label: "Inicio" },
    { href: "#", label: "Propiedades" },
    { href: "#", label: "Servicios" },
    { href: "#", label: "Nosotros" },
    { href: "#contacto", label: "Contacto" },
];
---

<header class="absolute top-0 inset-x-0 z-20 px-0 py-4">
    <div
        class="relative flex justify-between px-6 lg:px-(--padding-all-web) lg:max-w-7xl m-auto md:w-full items-center"
    >
        <div>
            <a href="/" aria-label="Terraza Capital, inicio">
                <img
                    src={Logo.src}
                    alt="Terraza Capital"
                    class="h-12 md:h-12 w-auto"
                    decoding="async"
                />
            </a>
        </div>

        <nav
            class="hidden md:flex gap-6 items-center text-secundario"
            role="navigation"
            aria-label="Principal"
        >
            {
                links.map((link) => (
                    <a
                        class="text-[1.1em] hover:text-primario transition-colors"
                        href={link.href}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="hidden md:flex">
            <GlassButton
                href="#contacto"
                variant="primary"
                size="sm"
                textColor="#ffffff"
            >
                <Icon name="whatsapp-solid" size={18} />
                Contactar
            </GlassButton>
        </div>

        <button
            id="icon-nav"
            type="button"
            class="md:hidden p-2 flex items-center rounded-2xl z-20 text-secundario"
            title="Abrir menú"
        >
            <svg
                id="icon-open"
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M4 6h16M4 12h16M4 18h16"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </button>
    </div>

    <nav
        id="mobile-menu"
        class="w-full h-dvh flex fixed inset-0 bg-body/90 backdrop-blur-2xl flex-col p-6 gap-6 z-50 overflow-y-auto"
        role="navigation"
        aria-label="Menú móvil"
    >
        <div class="flex justify-between items-center w-full">
            <a href="/" aria-label="Terraza Capital, inicio">
                <img
                    src={Logo.src}
                    alt="Terraza Capital"
                    class="h-10 w-auto"
                    decoding="async"
                />
            </a>

            <button
                id="btn-close"
                type="button"
                class="p-2 flex items-center rounded-2xl focus:outline-none text-secundario"
                title="Cerrar menú"
            >
                <svg
                    id="icon-close"
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M6 6l12 12M6 18L18 6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>
        </div>

        <div class="flex flex-col items-center gap-6 text-center mt-8 text-xl">
            {
                links.map((link) => (
                    <a
                        class="text-secundario w-full block py-3 border-b border-borde"
                        href={link.href}
                    >
                        {link.label}
                    </a>
                ))
            }

            <GlassButton
                href="#contacto"
                variant="primary"
                size="md"
                textColor="#ffffff"
            >
                <Icon name="whatsapp-solid" size={18} />
                Contactar
            </GlassButton>
            <div
                class="text-primario font-titulos font-bold flex flex-wrap justify-center gap-4.5"
            >
                <p class="w-full text-secundario">Redes Sociales</p>

                <a
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="YouTube de Terraza Capital"
                    title="Ir a YouTube - Terraza Capital"
                    class="-mt-0.5"
                >
                    <Icon name="icon-youtube" size={36} />
                </a>

                <a
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram de Terraza Capital"
                    title="Ir a Instagram - Terraza Capital"
                    class=""
                >
                    <Icon name="icon-instagram" size={30} />
                </a>

                <a
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="WhatsApp de Terraza Capital"
                    title="Contactar por WhatsApp - Terraza Capital"
                >
                    <Icon
                        name="whatsapp-solid"
                        size={30}
                        class="-mt-0.4 -ml-0.5"
                    />
                </a>

                <!--  -->
            </div>
        </div>
    </nav>

    <script>
        const btnOpen = document.getElementById("icon-nav");
        const btnClose = document.getElementById("btn-close");
        const menu = document.getElementById("mobile-menu");

        const scrollbarWidth = () => {
            const scrollWidth =
                window.innerWidth - document.documentElement.clientWidth;

            document.documentElement.style.setProperty(
                "--scrollbar-width",
                `${scrollWidth}px`,
            );
        };

        scrollbarWidth();
        if (btnOpen && btnClose && menu) {
            const setMenu = (open: boolean | undefined) => {
                const $body = document.body;
                menu.classList.toggle("open", open);

                if (menu.classList.contains("open")) {
                    $body?.classList.add("no-scrolling");
                }
                if (!menu.classList.contains("open")) {
                    $body?.classList.remove("no-scrolling");
                }
            };

            btnOpen.addEventListener("click", () => setMenu(true));

            btnClose.addEventListener("click", () => setMenu(false));

            menu.querySelectorAll("a").forEach((a) =>
                a.addEventListener("click", () => setMenu(false)),
            );

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") setMenu(false);
            });

            document.addEventListener("click", (e) => {
                if (!menu.classList.contains("open")) return;
                const target = e.target as Node;

                if (!menu.contains(target) && !btnOpen.contains(target)) {
                    setMenu(false);
                }
            });

            window.addEventListener("resize", () => {
                if (
                    window.innerWidth >= 768 &&
                    menu.classList.contains("open")
                ) {
                    setMenu(false);
                }
            });
        }
    </script>

    <style is:global>
        .no-scrolling {
            /* scrollbar-gutter: stable; */
            overflow: hidden;
            padding-right: var(--scrollbar-width);
        }
        #mobile-menu {
            transform: translateX(-100%);
            transition: all 0.4s ease-out;
        }
        .open {
            transform: translateX(0) !important;
            overflow: visible;
        }
    </style>
</header>
